# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=supportkit
POSTGRES_PASSWORD=supportkit-dev
POSTGRES_DB=supportkit
POSTGRES_PORT=5432

# Used by the app and migrations (host machine -> docker)
DATABASE_URL=postgresql://supportkit:supportkit-dev@localhost:5432/supportkit

# Deserialization hardening for langgraph-checkpoint 4.x (see PLAN.md 2.1)
LANGGRAPH_STRICT_MSGPACK=true

# LLM for the agent. "fake:rules" = built-in deterministic model (no API key, used by tests/CI).
# Real model example: SUPPORTKIT_MODEL=anthropic:<model-id>  (also set ANTHROPIC_API_KEY)
SUPPORTKIT_MODEL=fake:rules
# ANTHROPIC_API_KEY=

# DEMO ONLY: mounts /chat, which trusts X-Demo-* identity headers. Never enable on a real deployment.
SUPPORTKIT_DEMO_MODE=false
